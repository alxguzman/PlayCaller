# Copy this file to .env and fill in your real values.
# Never commit .env to git!

# --- Phase 4: Claude play-caller ---------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: which Claude model writes the explanations (default: haiku -
# fast + cheap, ideal for short coordinator-style blurbs).
# CLAUDE_MODEL=claude-haiku-4-5

# The dashboard and /explain are public; no login credentials are required.

# Check nflverse's API on startup and Tuesdays at 09:00 America/Los_Angeles;
# download changed data,
# rebuild features, retrain, and reload the model while the API stays online.
# Set to 0 to disable (e.g. a memory-limited production server).
NFL_DATA_REFRESH_ENABLED=1
